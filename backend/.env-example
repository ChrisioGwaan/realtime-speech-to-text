SPEECH_REGION=
SPEECH_KEY=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_AI_DEPLOYMENT=
ACCESS_TOKEN=

# --- OpenAI Realtime (platform.openai.com) ---
# Required to enable provider="openai" on the /ws/speech start action.
# Get the key from https://platform.openai.com/api-keys (starts with "sk-...").
OPENAI_API_KEY=
# Optional override; defaults to gpt-realtime-2.
OPENAI_REALTIME_MODEL=gpt-realtime-2
